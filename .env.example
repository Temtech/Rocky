# Copy to .env and fill securely; never commit credentials.
DEBUG=0
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
APP_DOMAIN=
POSTGRES_PASSWORD=
# Percent-encode password characters in this URL. Host is db in Compose.
DATABASE_URL=
DB_SSLMODE=prefer
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=
# Recommended for Vercel. Set this to resend and enter its API key securely.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
CSRF_TRUSTED_ORIGINS=
